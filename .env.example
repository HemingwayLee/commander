# Copy to .env and fill in ONE of these. Docker Compose reads .env automatically.

# Claude Pro/Max subscription: run `claude setup-token` in your terminal and paste the token.
CLAUDE_CODE_OAUTH_TOKEN=

# Or pay-as-you-go API billing with a key from https://platform.claude.com/
ANTHROPIC_API_KEY=

# How many answers may run at once (the rest wait).
MAX_CONCURRENT_TURNS=3

# Agents: MCP servers (Streamable HTTP) plugged in with the top bar's "Add agent" button.
# The URL its dialog starts with. Default is info-center (create a key on its Integrations tab, http://localhost:5678).
AGENT_MCP_URL=http://host.docker.internal:8765/mcp
